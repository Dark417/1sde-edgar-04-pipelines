# Copy to .env and fill in. .env is gitignored -- never commit a token.
#   set -a && . ./.env && set +a

# --- Deploy credentials. Read by the Databricks CLI and tools/dbx_verify.py only.
#     Pipeline code never reads these.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
# A *workspace* personal access token: Settings > Developer > Access tokens.
# It starts with "dapi". An account-level token or an OAuth secret returns
# 401 "Credential was not sent or was of an unsupported type for this API".
DATABRICKS_TOKEN=dapi00000000000000000000000000000000

# --- Pipeline settings. Resolution is env var -> SSM -> fail naming the key.
EDGAR_LOGICAL_DATE=2026-07-31
EDGAR_CATALOG=edgar

# autoloader (Databricks) | batch (local file-ledger reader -- ADR-003)
EDGAR_INGEST_MODE=autoloader
# volume (Databricks) | s3 | local
EDGAR_STORAGE_MODE=volume

# Both fall back to repo 2's SSM parameters when unset, which is the intended
# production path. Set them explicitly only for a local or ad-hoc run.
#EDGAR_LANDING_ROOT=/Volumes/edgar/landing/edgar
#EDGAR_EXPORT_ROOT=s3://your-serving-bucket

# --- Local harness only.
# The SEC requires a declared User-Agent and blocks by IP without one.
#EDGAR_USER_AGENT=Your Name your@email
